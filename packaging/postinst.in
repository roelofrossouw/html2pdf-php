#!/bin/sh
# Enables the html2pdf extension for every PHP @PHP_MINOR@ SAPI and restarts php-fpm (when it
# runs), on install and upgrade.
set -e
if [ "$1" = configure ]; then
    if command -v phpenmod >/dev/null 2>&1; then
        phpenmod -v @PHP_MINOR@ -s ALL html2pdf || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl try-restart php@PHP_MINOR@-fpm.service || true
    fi
fi
exit 0
